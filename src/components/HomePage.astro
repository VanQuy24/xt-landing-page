---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary, type Locale } from '../i18n';
import About from './sections/About.astro';
import Brief from './sections/Brief.astro';
import Clients from './sections/Clients.astro';
import Faq from './sections/Faq.astro';
import Hero from './sections/Hero.astro';
import Process from './sections/Process.astro';
import Products from './sections/Products.astro';
import Services from './sections/Services.astro';

// Section order follows design-system/xiontechs/content/en/home.md: our own products first, then services.
// §8 Why choose us was cut on 2026-10-12. §6 Testimonials ships only
// once an approved quote exists (content/open-data.md #8, #9).
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description}>
  <Hero lang={lang} />
  <Products lang={lang} />
  <Services lang={lang} />
  <Clients lang={lang} />
  <Process lang={lang} />
  <About lang={lang} />
  <Faq lang={lang} />
  <Brief lang={lang} />
</BaseLayout>
