---
import { getDictionary, type Locale } from '../../i18n';
import Container from '../ui/Container.astro';

interface Props {
  lang: Locale;
}

const t = getDictionary(Astro.props.lang);
---

<section class="py-20 sm:py-28">
  <Container>
    <div class="max-w-3xl">
      <h1 class="font-display text-display text-ink-900">{t.hero.title}</h1>
      <p class="text-lead text-ink-500 mt-6">{t.hero.subtitle}</p>
      <a
        href="#contact"
        class="bg-blue-600 hover:bg-blue-700 mt-10 inline-flex h-12 items-center rounded-md px-6 font-semibold text-white transition-colors duration-150"
      >
        {t.hero.cta}
      </a>
    </div>
  </Container>
</section>
