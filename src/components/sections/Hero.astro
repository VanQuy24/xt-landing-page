---
import { getDictionary, type Locale } from '../../i18n';
import Container from '../ui/Container.astro';

interface Props {
  lang: Locale;
}

const t = getDictionary(Astro.props.lang);
---

<section class="py-20 sm:py-28">
  <Container>
    <div class="max-w-3xl">
      <h1 class="font-display text-primary text-4xl leading-tight font-bold sm:text-5xl">{t.hero.title}</h1>
      <p class="text-secondary mt-6 text-lg">{t.hero.subtitle}</p>
      <a
        href="#contact"
        class="bg-accent text-on-primary focus-visible:outline-ring mt-10 inline-block rounded-lg px-6 py-3 font-semibold shadow-md transition-opacity duration-200 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        {t.hero.cta}
      </a>
    </div>
  </Container>
</section>
