---
import { getDictionary, type Locale } from '../../i18n';
import AppWindow from '../ui/AppWindow.astro';
import ProjectShowcase from '../ui/ProjectShowcase.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';

// Home §4. Buddy360 is left out until its line and photo are confirmed (content/open-data.md #4, #5).
// The feature list returns once we know which features are live (content/open-data.md).
interface Props {
  lang: Locale;
}

const t = getDictionary(Astro.props.lang);
const p = t.products;
---

<Section id="products" labelledby="products-title">
  <SectionHeader id="products-title" heading={p.heading} lead={p.intro} />
  <div class="mt-12">
    <ProjectShowcase tag={p.tag} title={p.platform.title} body={p.platform.body} caption={t.a11y.illustrative}>
      <AppWindow bar={p.window.bar} kpis={p.window.kpis} rows={p.window.rows} />
    </ProjectShowcase>
  </div>

  <article class="border-line mt-16 max-w-2xl rounded-lg border bg-white p-6 lg:p-8">
    <h3 class="font-display text-h3 text-ink-900">{p.timetabling.title}</h3>
    <p class="text-body text-ink-700 mt-3">{p.timetabling.body}</p>
  </article>
</Section>
