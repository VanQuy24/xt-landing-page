---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { company, telHref } from '../../data/company';
import { getDictionary, type Locale } from '../../i18n';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';

// MASTER §5.14: navy band, gold used once (the slogan). Three unequal columns: brand, contact, company.
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const links = [
  { href: getRelativeLocaleUrl(lang, 'careers'), label: t.nav.careers },
  { href: getRelativeLocaleUrl(lang, 'privacy-policy'), label: t.footer.privacy },
  { href: getRelativeLocaleUrl(lang, 'terms-of-service'), label: t.footer.terms },
];
const heading = 'text-label text-blue-200';
const link = 'inline-flex min-h-11 items-center hover:text-white hover:underline';
---

<footer class="bg-brand-navy text-small text-white/80">
  <Container class="grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-[2fr_1.5fr_1fr]">
    <div>
      <p class="font-display text-h3 text-white">XionTechs</p>
      <p class="mt-2">{t.footer.line}</p>
      <p class="font-display text-gold-400 mt-4 text-lg font-extrabold">{t.footer.slogan}</p>
    </div>

    <div>
      <h2 class={heading}>{t.footer.contactLabel}</h2>
      <ul class="mt-2">
        <li>
          <a class={link} href={telHref(company.phones.usa)}>
            {company.phones.usa}
          </a>
        </li>
        <li>
          <a class={link} href={telHref(company.phones.vietnam)}>
            {company.phones.vietnam}
          </a>
        </li>
        <li>
          <a class={link} href={`mailto:${company.email}`}>
            {company.email}
          </a>
        </li>
      </ul>
      <p class="mt-3">{t.footer.offices}</p>
    </div>

    <div>
      <h2 class={heading}>{t.footer.linksLabel}</h2>
      <ul class="mt-2">
        {links.map((l) => (
          <li>
            <a class={link} href={l.href}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <ul class="mt-4 flex gap-2">
        {company.social.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              aria-label={`${s.label} (${t.a11y.external})`}
              class="inline-flex size-11 items-center justify-center rounded-md transition-colors duration-150 hover:bg-white/10 hover:text-white"
            >
              <Icon name={s.icon} class="size-5" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Container>
  <div class="border-t border-white/15">
    <Container class="py-6 text-xs">
      <p>{t.footer.legal}</p>
    </Container>
  </div>
</footer>

<style>
  footer :focus-visible {
    outline-color: white;
  }
</style>
