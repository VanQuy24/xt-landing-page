---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getDictionary, type Locale } from '../../i18n';
import mark from '../../assets/xt-mark.png';
import LanguageSwitcher from '../LanguageSwitcher.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';

// MASTER §5.2. Section links jump to Home anchors from any page.
interface Props {
  lang: Locale;
  variant?: 'default' | 'home';
}

const { lang, variant = 'default' } = Astro.props;
const isHome = variant === 'home';
const t = getDictionary(lang);
const home = getRelativeLocaleUrl(lang);
const links = [
  { href: `${home}#services`, label: t.nav.services },
  { href: getRelativeLocaleUrl(lang, 'solutions'), label: t.nav.solutions },
  { href: `${home}#clients`, label: t.nav.clients },
  { href: `${home}#process`, label: t.nav.process },
  { href: `${home}#news`, label: t.nav.news },
  { href: `${home}#faq`, label: t.nav.faq },
  { href: getRelativeLocaleUrl(lang, 'careers'), label: t.nav.careers },
];
const contact = `${home}#contact`;
// Highlight the nav item for the page being viewed (anchors on Home are not tracked).
const current = (href: string) =>
  !href.includes('#') && Astro.url.pathname.replace(/\/$/, '') === href.replace(/\/$/, '');
---

<header
  data-header
  class:list={[
    'sticky top-0 z-50 border-b border-transparent bg-white transition-colors duration-150',
    { 'home-header': isHome },
  ]}
>
  <Container class="header-inner flex h-18 items-center gap-6">
    <a
      href={home}
      class="header-brand font-display text-h4 text-brand-navy flex min-h-11 shrink-0 items-center gap-2 font-extrabold"
      aria-label={t.a11y.home}
    >
      <Image src={mark} alt="" height={28} densities={[1, 2]} class="h-7 w-auto" loading="eager" />
      XionTechs
    </a>

    <nav aria-label={t.a11y.primaryNav} class="mx-auto hidden xl:block">
      <ul class="flex items-center gap-1">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={current(l.href) ? 'page' : undefined}
              class="text-ink-700 aria-[current=page]:after:bg-gold-400 relative inline-flex h-11 items-center px-3 text-[15px] whitespace-nowrap font-medium transition-colors duration-150 after:absolute after:inset-x-3 after:bottom-1.5 after:h-0.5 after:rounded-full hover:text-blue-600 aria-[current=page]:text-blue-600"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ms-auto flex items-center gap-3 xl:ms-0">
      <LanguageSwitcher lang={lang} />
      <div class="hidden lg:block">
        <Button href={contact} size="sm" variant={isHome ? 'highlight' : 'primary'}>
          {t.nav.cta}
          {isHome && <Icon name="arrow" class="size-5" />}
        </Button>
      </div>
      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="text-ink-900 inline-flex size-11 cursor-pointer items-center justify-center rounded-md xl:hidden"
      >
        <span data-when-closed>
          <span class="sr-only">{t.a11y.menuOpen}</span>
          <Icon name="menu" />
        </span>
        <span data-when-open hidden>
          <span class="sr-only">{t.a11y.menuClose}</span>
          <Icon name="x" />
        </span>
      </button>
    </div>
  </Container>

  <div
    id="mobile-menu"
    hidden
    class="border-line fixed inset-x-0 top-18 bottom-0 z-60 overflow-y-auto border-t bg-white px-4 pb-8 xl:hidden"
  >
    <nav aria-label={t.a11y.primaryNav}>
      <ul class="divide-line divide-y">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={current(l.href) ? 'page' : undefined}
              class="text-ink-900 flex h-14 items-center text-lg font-medium aria-[current=page]:text-blue-600"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <Button href={contact} variant={isHome ? 'highlight' : 'primary'} class="mt-6 w-full">
      {t.nav.cta}
      {isHome && <Icon name="arrow" class="size-5" />}
    </Button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const button = header.querySelector<HTMLButtonElement>('[data-menu-button]')!;
  const menu = header.querySelector<HTMLElement>('#mobile-menu')!;

  const onScroll = () => header.classList.toggle('border-line', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
    button.querySelector<HTMLElement>('[data-when-closed]')!.hidden = open;
    button.querySelector<HTMLElement>('[data-when-open]')!.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
    // Keep keyboard and screen-reader focus inside the open menu.
    for (const el of document.querySelectorAll<HTMLElement>('main, footer')) el.inert = open;
  };

  button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      setOpen(false);
      button.focus({ preventScroll: true });
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });
  matchMedia('(min-width: 1280px)').addEventListener('change', (e) => {
    if (!e.matches || button.getAttribute('aria-expanded') !== 'true') return;
    setOpen(false);
    // The browser may already have blurred a link when the media query hides the sheet.
    header.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
  });
</script>

<style>
  .home-header :global(.header-inner) {
    max-width: 1380px;
    padding-inline: clamp(1rem, 4.8vw, 4.625rem);
    gap: clamp(0.5rem, 1.6vw, 1.5rem);
  }
  .home-header .header-brand {
    font-size: clamp(1.125rem, 2.2vw, 2rem);
    letter-spacing: -0.05em;
    gap: clamp(0.375rem, 0.8vw, 0.75rem);
  }
  .home-header .header-brand :global(img) {
    height: clamp(1.5rem, 2.3vw, 2rem);
  }
  @media (min-width: 1280px) and (max-width: 1439px) {
    .home-header :global(.header-inner) {
      padding-inline: 1.5rem;
    }
    .home-header nav a {
      padding-inline: 0.5rem;
    }
  }
</style>
