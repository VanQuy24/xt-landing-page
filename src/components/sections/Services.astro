---
import { getDictionary, type Locale } from '../../i18n';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';

// Home §3. A flat two-column list, no cards or icons (MASTER §5.8): eight services read faster as rows than as boxes.
interface Props {
  lang: Locale;
}

const t = getDictionary(Astro.props.lang);
---

<Section id="services" labelledby="services-title" surface>
  <SectionHeader id="services-title" heading={t.services.heading} />
  <ul class="border-line mt-10 grid border-t sm:grid-cols-2 sm:gap-x-12">
    {t.services.items.map((s) => (
      <li class="border-line border-b py-5 lg:py-6">
        <h3 class="font-display text-h3 text-ink-900">{s.title}</h3>
        <p class="text-body text-ink-700 mt-2 max-w-xl">{s.body}</p>
      </li>
    ))}
  </ul>
</Section>
