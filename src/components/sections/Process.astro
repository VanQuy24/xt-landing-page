---
import { getDictionary, type Locale } from '../../i18n';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';

// Home §7, 4-D process. Static four-step version; this is also the no-JS fallback of the animated one.
interface Props {
  lang: Locale;
}

const t = getDictionary(Astro.props.lang);
const p = t.process;
---

<Section id="process" labelledby="process-title">
  <SectionHeader id="process-title" label={p.label} heading={p.heading} />
  <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {p.steps.map((s, i) => (
      <li class="border-line border-t-2 pt-6">
        <span class="text-label text-blue-600">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="font-display text-h3 text-ink-900 mt-2">{s.name}</h3>
        <p class="text-small text-ink-700 mt-3">{s.body}</p>
      </li>
    ))}
  </ol>
  <p class="text-small text-ink-500 mt-10">{p.note}</p>
</Section>
