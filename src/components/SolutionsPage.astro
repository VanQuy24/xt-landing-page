---
import { getRelativeLocaleUrl } from 'astro:i18n';
import clientVisit from '../assets/news/client-visit.jpg';
import { company } from '../data/company';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary, type Locale } from '../i18n';
import EssAgents from './solutions/EssAgents.astro';
import { Image } from 'astro:assets';
import heroGlobe from '../assets/global-network-globe-illustration.png';
import ParentPlatform from './solutions/ParentPlatform.astro';
import SmartPlatform from './solutions/SmartPlatform.astro';
import StaffPlatform from './solutions/StaffPlatform.astro';
import Button from './ui/Button.astro';
import Container from './ui/Container.astro';
import Icon, { type IconName } from './ui/Icon.astro';

// /solutions — copy from design-system/xiontechs/content/{en,vi}/solutions.md, layout and motion from
// design-system/xiontechs/pages/solutions.md. Hero navy → Parent white → Staff surface → ESS navy → XT Smart
// Platform surface (the umbrella that holds timetabling, the grader and XSS) → CTA band on white.
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const s = t.solutions;
const contact = `${getRelativeLocaleUrl(lang)}#contact`;
const jumps: { id: string; label: string; icon: IconName }[] = [
  { id: 'parent-platform', label: s.parent.nav, icon: 'phone' },
  { id: 'staff-platform', label: s.staff.nav, icon: 'window' },
  { id: 'ess-agents', label: s.ess.nav, icon: 'message' },
  { id: 'xt-smart-platform', label: s.smart.nav, icon: 'layers' },
];
---

<BaseLayout lang={lang} title={s.meta.title} description={s.meta.description}>
  <section
    aria-labelledby="solutions-title"
    class="from-surface border-line relative isolate overflow-hidden border-b bg-linear-to-b to-blue-50 xl:flex xl:aspect-[2095/750] xl:items-center"
  >
    <!-- Decorative globe illustration: the globe sits on the end side; the start side stays quiet for the text. -->
    <Image
      src={heroGlobe}
      alt=""
      width={2095}
      widths={[768, 1280, 1920, 2095]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 size-full object-cover object-[78%_center] xl:object-right xl:[mask-image:linear-gradient(to_right,transparent,black_18%)]"
    />
    <div
      class="from-surface via-surface/85 absolute inset-0 -z-10 bg-linear-to-r to-transparent xl:hidden"
      aria-hidden="true"
    ></div>
    <Container class="flex min-h-[460px] items-center py-16 lg:min-h-[500px] lg:py-20 xl:min-h-0 xl:w-full xl:py-12">
      <div class="max-w-xl">
        <p class="text-label flex items-center gap-3 text-blue-600 uppercase">
          <span class="bg-gold-400 h-1 w-8 rounded-full" aria-hidden="true"></span>
          {s.label}
        </p>
        <h1 id="solutions-title" class="font-display text-display text-ink-900 mt-4">
          {s.heading}
        </h1>
        <p class="text-lead text-ink-700 mt-6">{s.lead}</p>
        <nav aria-label={s.jumpLabel} class="mt-10">
          <ul class="flex flex-wrap gap-2">
            {jumps.map((j) => (
              <li>
                <a
                  href={`#${j.id}`}
                  class="border-line text-ink-900 inline-flex h-11 items-center gap-2 rounded-full border bg-white px-4 text-sm font-semibold whitespace-nowrap shadow-1 transition-colors duration-150 hover:border-blue-200 hover:text-blue-600"
                >
                  <Icon name={j.icon} class="size-4 text-blue-600" />
                  {j.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </Container>
  </section>

  <ParentPlatform lang={lang} />
  <StaffPlatform lang={lang} surface reverse />
  <EssAgents lang={lang} />
  <SmartPlatform lang={lang} surface />

  <section aria-labelledby="solutions-cta" class="bg-white py-16 lg:py-24">
    <Container>
      <div class="shadow-2 grid overflow-hidden rounded-lg lg:grid-cols-12">
        <div class="bg-brand-navy bg-dots p-8 text-white sm:p-10 lg:col-span-7 lg:p-14">
          <span class="bg-gold-400 block h-1 w-8 rounded-full" aria-hidden="true"></span>
          <h2 id="solutions-cta" class="font-display text-h2 mt-4">
            {s.cta.heading}
          </h2>
          <p class="text-lead mt-3 text-blue-100">{s.cta.lead}</p>
          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            <div>
              <p class="text-label text-blue-100 uppercase">{s.cta.use.label}</p>
              <Button href={contact} variant="highlight" class="mt-3 focus-visible:outline-white">
                {s.cta.use.button}
              </Button>
            </div>
            <div>
              <p class="text-label text-blue-100 uppercase">{s.cta.build.label}</p>
              <Button href={contact} variant="light" class="mt-3 focus-visible:outline-white">
                {s.cta.build.button}
                <Icon name="arrow" class="size-5" />
              </Button>
            </div>
          </div>
          <p class="text-small mt-8 text-blue-100">
            <span class="flex items-center gap-2">
              <Icon name="mail" class="size-4 shrink-0" />
              <a
                href={`mailto:${company.email}`}
                class="font-semibold text-white underline-offset-4 hover:underline focus-visible:outline-white"
              >
                {company.email}
              </a>
            </span>
            <span class="mt-1 block ps-6">{s.cta.reply}</span>
          </p>
        </div>
        <figure class="relative order-first aspect-video lg:order-none lg:col-span-5 lg:aspect-auto lg:min-h-80">
          <Image
            src={clientVisit}
            alt={s.cta.photo.alt}
            widths={[480, 960]}
            sizes="(min-width: 1024px) 500px, calc(100vw - 2rem)"
            class="absolute inset-0 size-full object-cover"
          />
          <figcaption class="bg-brand-navy/70 text-small absolute inset-x-0 bottom-0 px-4 py-2 text-white">
            {s.cta.photo.caption}
          </figcaption>
        </figure>
      </div>
    </Container>
  </section>
</BaseLayout>
