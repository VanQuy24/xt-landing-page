---
import { getDictionary, type Locale } from '../../i18n';
import Icon, { type IconName } from '../ui/Icon.astro';
import ProjectShowcase from '../ui/ProjectShowcase.astro';
import Section from '../ui/Section.astro';
import Stage from './Stage.astro';
import Typing from './Typing.astro';
import WindowFrame from './WindowFrame.astro';

// Solutions §1 (pages/solutions.md): a phone with a real Tap / Chat switch. Tap shows the screens, Chat shows
// the A2UI flow: the parent asks, the assistant answers with the filled-in form. The server HTML is the
// finished Chat state (no JS, reduced motion); src/scripts/solutions.ts alternates the two while on screen.
interface Props {
  lang: Locale;
  surface?: boolean;
  reverse?: boolean;
}

const { lang, surface = false, reverse = false } = Astro.props;
const t = getDictionary(lang);
const p = t.solutions.parent;
const v = p.viz;
const w = v.web;
const navIcons: IconName[] = ['bell', 'file', 'sliders'];
const avatar = v.fields[0]?.v ?? '';
---

<Section id="parent-platform" labelledby="parent-platform-title" surface={surface}>
  <ProjectShowcase
    tag={p.tag}
    title={p.title}
    titleTag="h2"
    titleId="parent-platform-title"
    body={p.body}
    numbers={p.numbers}
    chips={p.chips}
    caption={t.a11y.illustrative}
    reverse={reverse}
    hook={p.hook}
    more={t.solutions.more}
  >
    <Stage accent="gold">
      <div data-viz="parent" class="relative flex justify-center lg:justify-end">
        <WindowFrame bar={w.bar} class="absolute start-0 top-6 hidden w-[74%] lg:block">
          <div aria-hidden="true" class="grid min-h-72 grid-cols-[8.5rem_1fr]">
            <ul class="border-line bg-surface flex flex-col gap-1 border-e p-2 text-[11px]">
              {w.nav.map((item, i) => (
                <li
                  class:list={[
                    'flex items-center gap-1.5 rounded-sm px-2 py-1.5 font-semibold',
                    i === 0 ? 'bg-blue-100 text-blue-700' : 'text-ink-700',
                  ]}
                >
                  <Icon name={navIcons[i] ?? 'file'} class="size-3.5 shrink-0" />
                  <span class="truncate">{item}</span>
                </li>
              ))}
            </ul>
            <div class="p-3">
              <p class="text-ink-500 text-[11px] font-semibold">{w.title}</p>
              <div class="border-line mt-2 rounded-md border bg-white p-3">
                <p class="flex items-center gap-2">
                  <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-blue-100 text-[10px] font-semibold text-blue-700">
                    AN
                  </span>
                  <span class="text-ink-900 text-xs font-semibold">{w.student}</span>
                </p>
                <div class="border-line mt-3 flex gap-3 border-b text-[11px] font-semibold">
                  {w.tabs.map((tab, i) => (
                    <span
                      class:list={[
                        'relative pb-1.5',
                        i === 0
                          ? 'text-blue-600 after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 after:bg-blue-600'
                          : 'text-ink-500',
                      ]}
                    >
                      {tab}
                    </span>
                  ))}
                </div>
                <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1.5 text-[11px]">
                  {w.fields.map((f) => (
                    <>
                      <dt class="text-ink-500">{f.k}</dt>
                      <dd class="text-ink-900 font-semibold">{f.v}</dd>
                    </>
                  ))}
                </dl>
              </div>
            </div>
          </div>
        </WindowFrame>
        <p class="sr-only">{p.summary}</p>
        <div class="bg-ink-900 shadow-2 relative z-10 w-full max-w-75 rounded-[2rem] p-2.5 lg:max-w-68">
          <div class="flex flex-col overflow-hidden rounded-[1.5rem] bg-white">
            <div aria-hidden="true" class="flex items-center justify-between px-4 pt-4 pb-3">
              <span class="text-ink-900 text-sm font-semibold">{v.app}</span>
              <span class="flex size-7 items-center justify-center rounded-full bg-blue-100 text-xs font-semibold text-blue-700">
                {avatar}
              </span>
            </div>

            <div
              role="group"
              aria-label={v.modes}
              class="border-line mx-3 grid grid-cols-2 gap-1 rounded-md border bg-white p-1"
            >
              {(['tap', 'chat'] as const).map((mode) => (
                <button
                  type="button"
                  data-mode={mode}
                  aria-pressed={mode === 'chat' ? 'true' : 'false'}
                  class="text-ink-700 min-h-11 cursor-pointer rounded-sm text-sm font-semibold transition-colors duration-150 hover:text-blue-600 aria-pressed:bg-blue-600 aria-pressed:text-white"
                >
                  {v[mode]}
                </button>
              ))}
            </div>

            <div aria-hidden="true" class="grid p-3">
              <div data-panel="tap" data-s="fade" class="col-start-1 row-start-1 grid content-start gap-3">
                <div data-s="rise" class="border-line rounded-md border bg-white p-3">
                  <p class="text-ink-500 text-xs font-semibold">{v.progress}</p>
                  {v.subjects.map((s, i) => (
                    <div class="mt-2">
                      <div class="flex items-baseline justify-between text-xs">
                        <span class="text-ink-700">{s.name}</span>
                        <span class="font-display text-ink-900 font-bold tabular-nums">{s.value}%</span>
                      </div>
                      <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-blue-100">
                        <div
                          data-s="grow-x"
                          class="h-full rounded-full bg-blue-600"
                          style={`width:${s.value}%;--i:${i + 2}`}
                        />
                      </div>
                    </div>
                  ))}
                </div>
                <div data-s="rise" style="--i:1" class="border-line rounded-md border bg-white p-3">
                  <p class="text-ink-900 flex items-center gap-2 text-sm font-semibold">
                    <Icon name="file" class="size-4 text-blue-600" />
                    {v.form}
                  </p>
                  <dl class="mt-2 grid gap-1.5 text-xs">
                    {v.fields.map((f) => (
                      <div class="border-line flex justify-between gap-3 rounded-sm border px-2.5 py-2">
                        <dt class="text-ink-500">{f.k}</dt>
                        <dd class="text-ink-900 font-semibold">{f.v}</dd>
                      </div>
                    ))}
                  </dl>
                  <span class="mt-3 flex h-9 items-center justify-center rounded-md bg-blue-600 text-sm font-semibold text-white">
                    {v.submit}
                  </span>
                </div>
              </div>

              <div data-panel="chat" data-s="fade" data-on class="col-start-1 row-start-1 flex flex-col gap-3">
                <p
                  data-chat="ask"
                  data-s="rise"
                  data-on
                  class="ms-auto max-w-[85%] rounded-md rounded-ee-sm bg-blue-600 px-3 py-2 text-xs leading-relaxed text-white"
                >
                  {v.ask}
                </p>
                <div class="grid justify-items-start">
                  <Typing data-chat="typing" class="col-start-1 row-start-1" />
                  <div
                    data-chat="card"
                    data-s="rise"
                    data-on
                    class="border-line col-start-1 row-start-1 w-full rounded-md rounded-es-sm border bg-white p-3"
                  >
                    <p class="text-ink-900 flex items-center gap-2 text-sm font-semibold">
                      <Icon name="file" class="size-4 text-blue-600" />
                      {v.form}
                    </p>
                    <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-xs">
                      {v.fields.map((f) => (
                        <>
                          <dt class="text-ink-500">{f.k}</dt>
                          <dd class="text-ink-900 font-semibold">{f.v}</dd>
                        </>
                      ))}
                    </dl>
                    <span class="mt-3 flex h-9 items-center justify-center rounded-md bg-blue-600 text-sm font-semibold text-white">
                      {v.confirm}
                    </span>
                  </div>
                </div>
                <p
                  data-chat="sent"
                  data-s="rise"
                  data-on
                  class="text-success flex items-center gap-1.5 text-xs font-semibold"
                >
                  <Icon name="check" class="size-4 shrink-0" />
                  {v.sent}
                </p>
              </div>
            </div>

            <span aria-hidden="true" class="bg-ink-400 mx-auto mt-1 mb-2 h-1 w-24 rounded-full"></span>
          </div>
        </div>
      </div>
    </Stage>
  </ProjectShowcase>
</Section>

<script>
  import { initViz } from '../../scripts/solutions';

  initViz('parent');
</script>
