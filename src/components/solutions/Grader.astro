---
import { getDictionary, type Locale } from '../../i18n';
import Chip from '../ui/Chip.astro';
import Icon from '../ui/Icon.astro';
import ProjectShowcase from '../ui/ProjectShowcase.astro';
import Stage from './Stage.astro';
import WindowFrame from './WindowFrame.astro';

// Solutions §4b (pages/solutions.md): Grader agent, a sub-product inside the XT Smart Platform section. A marking
// window in the brand's light style: students, a read-aloud passage checked word by word, and the AI's proposed
// mark from three rubric criteria. The note "nothing is final until the teacher approves" sits in the assessment panel. Plays once in view: words light up in reading order, bars fill, the mark
// counts up. The server HTML is the finished state. Below `sm` the student list is hidden.
interface Props {
  lang: Locale;
  reverse?: boolean;
}

const { lang, reverse = false } = Astro.props;
const t = getDictionary(lang);
const p = t.solutions.grader;
const v = p.viz;

// Passage markup: ~word~ was skipped, ^word^ was read differently, anything else matched.
type Kind = 'matched' | 'skipped' | 'different';
const words = v.passage.split(/\s+/).map((raw) => {
  const kind: Kind = raw.startsWith('~') ? 'skipped' : raw.startsWith('^') ? 'different' : 'matched';
  return { kind, text: raw.replace(/[~^]/g, '') };
});
const count = (k: Kind) => words.filter((w) => w.kind === k).length;
const fill: Record<Kind, string> = {
  matched: 'bg-blue-50',
  skipped: 'border border-line bg-surface',
  different: 'bg-gold-100',
};
const text: Record<Kind, string> = {
  matched: 'text-ink-900',
  skipped: 'text-danger line-through',
  different: 'text-ink-900',
};
const selected = v.students.length - 1;
---

<div id="grader">
  <ProjectShowcase
    tag={p.category}
    title={p.title}
    titleTag="h3"
    titleId="grader-title"
    compact
    body={p.body}
    chips={p.chips}
    caption={t.a11y.illustrative}
    reverse={reverse}
    hook={p.hook}
    more={t.solutions.more}
  >
    <div data-viz="grader">
      <p class="sr-only">
        {p.summary} {v.note}
      </p>
      <Stage accent="blue">
        <WindowFrame bar={v.bar}>
          <div aria-hidden="true" class="grid sm:grid-cols-[7.5rem_1fr_12.5rem]">
            <ul class="border-line bg-surface hidden flex-col gap-1 border-e p-2 sm:flex">
              {v.students.map((s, i) => (
                <li
                  class:list={[
                    'rounded-sm px-2.5 py-2 text-xs',
                    i === selected ? 'bg-blue-100 text-blue-700' : 'text-ink-700',
                  ]}
                >
                  <span class="block font-semibold">{s.name}</span>
                  <span class="tabular-nums">{s.mark}</span>
                </li>
              ))}
            </ul>

            <div class="p-4">
              <p class="text-ink-900 flex items-center gap-2 text-sm font-semibold">
                <Icon name="file" class="size-4 shrink-0 text-blue-600" />
                {v.passageTitle}
              </p>
              <p lang="en" class="mt-3 flex flex-wrap gap-1 text-xs">
                {words.map((w, i) => (
                  <span class:list={['relative inline-flex rounded-sm px-1 py-0.5', text[w.kind]]}>
                    <span
                      data-word
                      data-s="fade"
                      data-on
                      style={`--i:${i};--stagger:20ms`}
                      class:list={['absolute inset-0 rounded-sm', fill[w.kind]]}
                    />
                    <span class="relative">{w.text}</span>
                  </span>
                ))}
              </p>
              <ul class="text-ink-700 mt-3 flex flex-wrap gap-x-3 gap-y-1 text-[11px]">
                {(['matched', 'skipped', 'different'] as const).map((k) => (
                  <li class="flex items-center gap-1.5">
                    <span class:list={['size-3 rounded-sm', fill[k]]} />
                    {v.legend[k]} <span class="font-semibold tabular-nums">{count(k)}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="border-line bg-surface flex flex-col border-t p-4 sm:border-s sm:border-t-0">
              <p class="text-ink-900 flex items-center gap-2 text-sm font-semibold">
                <Icon name="spark" class="size-4 shrink-0 text-blue-600" />
                {v.assessment}
              </p>
              <p class="text-ink-500 mt-3 text-[11px]">{v.proposed}</p>
              <p class="mt-0.5 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                <span class="font-display text-num-md text-ink-900 tabular-nums">
                  <span data-mark>{v.mark}</span>
                  <span class="text-ink-500 text-sm">{v.outOf}</span>
                </span>
                <Chip tone="success" size="xs">
                  <Icon name="check" class="size-3" />
                  {v.grade}
                </Chip>
              </p>
              <dl class="mt-3 grid gap-2 text-xs">
                {v.rubric.map((r, i) => (
                  <div>
                    <div class="flex justify-between gap-2">
                      <dt class="text-ink-700">{r.name}</dt>
                      <dd class="text-ink-900 font-semibold tabular-nums">{r.score}/10</dd>
                    </div>
                    <div class="bg-line mt-1 h-1.5 overflow-hidden rounded-full">
                      <div
                        data-rubric
                        data-s="grow-x"
                        data-on
                        style={`width:${r.score * 10}%;--i:${i}`}
                        class="h-full rounded-full bg-blue-600"
                      />
                    </div>
                  </div>
                ))}
              </dl>
              <p class="text-ink-500 mt-4 flex items-start gap-1.5 text-xs">
                <Icon name="shield" class="mt-px size-3.5 shrink-0" />
                {v.note}
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                <span class="inline-flex h-8 items-center rounded-md border-[1.5px] border-blue-600 bg-white px-3 text-xs font-semibold text-blue-600">
                  {v.save}
                </span>
                <span class="inline-flex h-8 items-center rounded-md bg-blue-600 px-3 text-xs font-semibold text-white">
                  {v.approve}
                </span>
              </div>
            </div>
          </div>
        </WindowFrame>
      </Stage>
    </div>
  </ProjectShowcase>
</div>

<script>
  import { initViz } from '../../scripts/solutions';

  initViz('grader');
</script>
