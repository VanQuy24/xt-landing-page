---
import { getDictionary, type Locale } from '../../i18n';
import Chip from '../ui/Chip.astro';
import Icon from '../ui/Icon.astro';
import ProjectShowcase from '../ui/ProjectShowcase.astro';
import Section from '../ui/Section.astro';
import Stage from './Stage.astro';
import Typing from './Typing.astro';
import WindowFrame from './WindowFrame.astro';

// Solutions §2 (pages/solutions.md): the staff portal already has a full UI; the assistant overrides the page
// you are on. Default: the Attendance module (KPIs + week). "Who was late today?" turns the page into a late
// list ("Changed by assistant"); "Open wellbeing for Grade 10" switches the module tab and shows the wellbeing
// tiles; then back to the default page and loop. Server HTML = the first override (late list). The chat
// stacks under the page below `sm`.
interface Props {
  lang: Locale;
  surface?: boolean;
  reverse?: boolean;
}

const { lang, surface = false, reverse = false } = Astro.props;
const t = getDictionary(lang);
const p = t.solutions.staff;
const v = p.viz;
const bubble = 'ms-auto max-w-[90%] rounded-md rounded-ee-sm bg-blue-600 px-3 py-2 text-xs leading-relaxed text-white';
const done =
  'border-line text-ink-700 col-start-1 row-start-1 inline-flex items-center gap-1.5 rounded-md rounded-es-sm border bg-white px-2.5 py-1.5 text-[11px] font-semibold';
---

<Section id="staff-platform" labelledby="staff-platform-title" surface={surface}>
  <ProjectShowcase
    tag={p.tag}
    title={p.title}
    titleTag="h2"
    titleId="staff-platform-title"
    body={p.body}
    numbers={p.numbers}
    chips={p.chips}
    caption={t.a11y.illustrative}
    reverse={reverse}
    hook={p.hook}
    more={t.solutions.more}
  >
    <div data-viz="staff">
      <p class="sr-only">{p.summary}</p>
      <Stage accent="blue">
        <WindowFrame bar={v.bar}>
          <div aria-hidden="true">
            <div class="border-line flex items-center gap-2 border-b px-3">
              <ul class="flex min-w-0 flex-1 gap-3 sm:gap-4">
                {v.tabs.map((tab, i) => (
                  <li
                    data-tab={String(i)}
                    data-active={i === 0 ? '' : undefined}
                    class:list={[
                      'text-ink-500 data-active:text-blue-600 relative py-2.5 text-[11px] font-semibold whitespace-nowrap transition-colors duration-150',
                      (i === 2 || i === 4) && 'hidden sm:block',
                    ]}
                  >
                    {tab}
                    <span
                      data-underline
                      data-s="fade"
                      data-on={i === 0 ? '' : undefined}
                      class="absolute inset-x-0 bottom-0 h-0.5 rounded-full bg-blue-600"
                    />
                  </li>
                ))}
              </ul>
              <span class="bg-danger inline-flex h-7 shrink-0 items-center gap-1 rounded-sm px-2 text-[11px] font-semibold text-white">
                <Icon name="alert" class="size-3.5" />
                {v.emergency}
              </span>
            </div>

            <div class="grid sm:grid-cols-[1fr_36%]">
              <div class="grid p-3 sm:p-4">
                <div data-view="page" data-s="fade" class="col-start-1 row-start-1">
                  <p class="text-ink-900 text-sm font-semibold">{v.page}</p>
                  <div class="mt-2 grid grid-cols-2 gap-2">
                    {v.kpis.map((k, i) => (
                      <div
                        data-s="rise"
                        data-on
                        style={`--i:${i}`}
                        class="border-line rounded-md border bg-white p-2.5"
                      >
                        <p class="text-ink-500 truncate text-[10px] font-semibold">{k.label}</p>
                        <p class="font-display text-ink-900 text-lg font-bold tabular-nums">{k.value}</p>
                        <p class="text-ink-500 truncate text-[10px]">{k.delta}</p>
                      </div>
                    ))}
                  </div>
                  <div class="mt-3 grid grid-cols-5 gap-1">
                    {v.week.map((day, d) => (
                      <div data-s="rise" data-on style={`--i:${d + 4}`} class="grid gap-1">
                        <span class="text-ink-500 text-center text-[10px] font-semibold">{v.days[d]}</span>
                        {day.map((block) => (
                          <span class="truncate rounded-sm border border-blue-200 bg-blue-50 px-1 py-1 text-center text-[9px] font-semibold text-blue-700">
                            {block}
                          </span>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>

                <div data-view="late" data-s="fade" data-on class="col-start-1 row-start-1">
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <p class="text-ink-900 text-sm font-semibold">{v.lateTitle}</p>
                    <span class="inline-flex items-center gap-1 rounded-sm bg-blue-50 px-1.5 py-0.5 text-[10px] font-semibold text-blue-700">
                      {v.changed}
                    </span>
                  </div>
                  <ul class="border-line divide-line mt-2 divide-y rounded-md border bg-white">
                    {v.late.map((s, i) => (
                      <li data-s="rise" data-on style={`--i:${i}`} class="flex items-center gap-2 px-2.5 py-2 text-xs">
                        <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-blue-100 text-[10px] font-semibold text-blue-700">
                          {s.name.slice(0, 1)}
                        </span>
                        <span class="text-ink-900 min-w-0 flex-1 truncate font-semibold">{s.name}</span>
                        <span class="text-ink-500">{s.group}</span>
                        <Chip size="xs">{s.time}</Chip>
                      </li>
                    ))}
                  </ul>
                  <div class="mt-2.5 flex flex-wrap items-center gap-3">
                    <span
                      data-s="rise"
                      data-on
                      style="--i:3"
                      class="inline-flex h-8 items-center gap-1.5 rounded-md bg-blue-600 px-3 text-xs font-semibold text-white"
                    >
                      <Icon name="mail" class="size-3.5" />
                      {v.notify}
                    </span>
                    <span class="text-[11px] font-semibold text-blue-600 underline underline-offset-2">{v.back}</span>
                  </div>
                </div>

                <div data-view="wellbeing" data-s="fade" class="col-start-1 row-start-1">
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <p class="text-ink-900 text-sm font-semibold">{v.wellbeingTitle}</p>
                    <span class="inline-flex items-center gap-1 rounded-sm bg-blue-50 px-1.5 py-0.5 text-[10px] font-semibold text-blue-700">
                      {v.changed}
                    </span>
                  </div>
                  <div class="mt-2 grid grid-cols-2 gap-2">
                    {v.wellbeing.map((w, i) => (
                      <div data-s="pop" style={`--i:${i}`} class="border-line rounded-md border bg-white p-2.5">
                        <p class="text-ink-500 text-[10px] font-semibold">{w.label}</p>
                        <p class="font-display text-ink-900 text-lg font-bold tabular-nums">{w.value}</p>
                        <p class="text-ink-500 truncate text-[10px]">{v.wellbeingNote}</p>
                      </div>
                    ))}
                  </div>
                  <span class="mt-2.5 inline-block text-[11px] font-semibold text-blue-600 underline underline-offset-2">
                    {v.back}
                  </span>
                </div>
              </div>

              <div class="border-line bg-surface flex flex-col gap-2 border-t p-3 sm:border-s sm:border-t-0">
                <p class="text-ink-900 flex items-center gap-1.5 text-xs font-semibold">
                  <span class="flex size-5 items-center justify-center rounded-full bg-blue-600 text-white">
                    <Icon name="spark" class="size-3" />
                  </span>
                  {v.assistant}
                </p>
                <p class="border-line text-ink-700 max-w-[90%] rounded-md rounded-es-sm border bg-white px-3 py-2 text-xs">
                  {v.greeting}
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {v.topics.map((topic) => (
                    <Chip size="xs">{topic}</Chip>
                  ))}
                </div>
                <p data-chat="ask1" data-s="rise" data-on class={bubble}>
                  {v.ask1}
                </p>
                <div class="grid justify-items-start">
                  <Typing data-chat="typing1" class="col-start-1 row-start-1" />
                  <p data-chat="done1" data-s="rise" data-on class={done}>
                    <Icon name="check" class="size-3.5 text-blue-600" />
                    {v.done1}
                  </p>
                </div>
                <p data-chat="ask2" data-s="rise" class={bubble}>
                  {v.ask2}
                </p>
                <div class="grid justify-items-start">
                  <Typing data-chat="typing2" class="col-start-1 row-start-1" />
                  <p data-chat="done2" data-s="rise" class={done}>
                    <Icon name="check" class="size-3.5 text-blue-600" />
                    {v.done2}
                  </p>
                </div>
                <div class="border-line text-ink-500 mt-auto flex h-9 items-center justify-between gap-2 rounded-md border bg-white px-3 text-xs">
                  <span class="truncate">{v.input}</span>
                  <Icon name="arrow" class="size-4 shrink-0 text-blue-600" />
                </div>
              </div>
            </div>
          </div>
        </WindowFrame>
      </Stage>
    </div>
  </ProjectShowcase>
</Section>

<script>
  import { initViz } from '../../scripts/solutions';

  initViz('staff');
</script>
