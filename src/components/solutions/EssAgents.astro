---
import { getDictionary, type Locale } from '../../i18n';
import Icon from '../ui/Icon.astro';
import ProjectShowcase from '../ui/ProjectShowcase.astro';
import Section from '../ui/Section.astro';
import Stage from './Stage.astro';
import Typing from './Typing.astro';
import WindowFrame from './WindowFrame.astro';

// Solutions §3 (pages/solutions.md): a generic chat app (no Microsoft branding or logos) where the HR assistant
// answers with a card, and 15 tiles for the 15 agents (no invented agent names). Plays once when scrolled
// into view; the server HTML is the finished state.
interface Props {
  lang: Locale;
  reverse?: boolean;
}

const { lang, reverse = false } = Astro.props;
const t = getDictionary(lang);
const p = t.solutions.ess;
const v = p.viz;
const agents = Number(p.numbers[0]?.value ?? 15);
---

<Section id="ess-agents" labelledby="ess-agents-title" dark>
  <ProjectShowcase
    tag={p.tag}
    title={p.title}
    titleTag="h2"
    titleId="ess-agents-title"
    body={p.body}
    numbers={p.numbers}
    chips={p.chips}
    caption={t.a11y.illustrative}
    reverse={reverse}
    hook={p.hook}
    more={t.solutions.more}
    dark
  >
    <Stage accent="blue" dark>
      <div data-viz="ess" class="grid gap-4 sm:grid-cols-[1fr_auto]">
        <p class="sr-only">{p.summary}</p>
        <WindowFrame>
          <div aria-hidden="true" class="grid grid-cols-[auto_1fr]">
            <div class="border-line bg-surface flex flex-col items-center gap-2 border-e p-2">
              <span class="size-7 rounded-sm bg-blue-100"></span>
              <span class="bg-line size-7 rounded-sm"></span>
              <span class="bg-line size-7 rounded-sm"></span>
              <span class="bg-line size-7 rounded-sm"></span>
            </div>
            <div class="flex min-w-0 flex-col">
              <div class="border-line flex items-center gap-2 border-b px-4 py-2.5">
                <span class="flex size-7 items-center justify-center rounded-full bg-blue-600 text-white">
                  <Icon name="spark" class="size-4" />
                </span>
                <span class="text-ink-900 text-sm font-semibold">{v.app}</span>
              </div>
              <div class="bg-surface flex flex-1 flex-col gap-3 p-4">
                <p
                  data-chat="ask"
                  data-s="rise"
                  data-on
                  class="ms-auto max-w-[85%] rounded-md rounded-ee-sm bg-blue-600 px-3 py-2 text-xs leading-relaxed text-white"
                >
                  {v.ask}
                </p>
                <div class="grid justify-items-start">
                  <Typing data-chat="typing" class="col-start-1 row-start-1" />
                  <div
                    data-chat="card"
                    data-s="rise"
                    data-on
                    class="border-line col-start-1 row-start-1 w-full max-w-xs rounded-md rounded-es-sm border bg-white p-3"
                  >
                    <p class="text-ink-900 flex items-center gap-2 text-sm font-semibold">
                      <Icon name="calendar" class="size-4 text-blue-600" />
                      {v.card}
                    </p>
                    <dl class="divide-line mt-2 divide-y text-xs">
                      {v.rows.map((r) => (
                        <div class="flex items-baseline justify-between gap-3 py-1.5">
                          <dt class="text-ink-500">{r.k}</dt>
                          <dd class="font-display text-ink-900 text-sm font-bold">{r.v}</dd>
                        </div>
                      ))}
                    </dl>
                    <div class="mt-3 flex flex-wrap gap-2">
                      <span class="inline-flex h-8 items-center rounded-md bg-blue-600 px-3 text-xs font-semibold text-white">
                        {v.primary}
                      </span>
                      <span class="inline-flex h-8 items-center rounded-md border-[1.5px] border-blue-600 bg-white px-3 text-xs font-semibold text-blue-600">
                        {v.secondary}
                      </span>
                    </div>
                  </div>
                </div>
                <div class="border-line text-ink-500 mt-auto flex h-9 items-center justify-between gap-2 rounded-md border bg-white px-3 text-xs">
                  <span class="truncate">{v.input}</span>
                  <Icon name="arrow" class="size-4 shrink-0 text-blue-600" />
                </div>
              </div>
            </div>
          </div>
        </WindowFrame>

        <div
          aria-hidden="true"
          class="border-line flex items-center justify-center gap-4 self-center rounded-lg border bg-white p-4 sm:flex-col sm:px-5"
        >
          <div class="grid grid-cols-5 gap-1.5">
            {Array.from({ length: agents }, (_, i) => (
              <span class="relative size-6 rounded-sm bg-blue-100">
                <span
                  data-tile
                  data-s="pop"
                  data-on
                  style={`--i:${i * 2}`}
                  class="absolute inset-0 rounded-sm bg-blue-600"
                />
              </span>
            ))}
          </div>
          <p class="font-display text-ink-900 text-sm font-bold">{v.agents}</p>
        </div>
      </div>
    </Stage>
  </ProjectShowcase>
</Section>

<script>
  import { initViz } from '../../scripts/solutions';

  initViz('ess');
</script>
