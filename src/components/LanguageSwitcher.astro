---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getDictionary, localeNames, locales, stripLocale, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const path = stripLocale(Astro.url.pathname, lang);
---

<nav aria-label={t.nav.language}>
  <ul class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
    {locales.map((l) => (
      <li>
        <a
          href={getRelativeLocaleUrl(l, path)}
          lang={l}
          hreflang={l}
          aria-current={l === lang ? 'page' : undefined}
          class="text-secondary hover:text-accent aria-[current=page]:text-foreground focus-visible:outline-ring rounded-sm transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 aria-[current=page]:font-semibold"
        >
          {localeNames[l]}
        </a>
      </li>
    ))}
  </ul>
</nav>
