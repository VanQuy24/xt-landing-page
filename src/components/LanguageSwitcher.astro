---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getDictionary, localeNames, locales, stripLocale, type Locale } from '../i18n';

// MASTER §5.3: short codes (EN / VI). The endonym follows for screen readers, so the accessible
// name still contains the visible code (WCAG 2.5.3).
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const path = stripLocale(Astro.url.pathname, lang);
---

<nav aria-label={t.nav.language}>
  <ul class="divide-line flex items-center divide-x text-sm font-semibold">
    {locales.map((l) => (
      <li>
        <a
          href={getRelativeLocaleUrl(l, path)}
          lang={l}
          hreflang={l}
          title={localeNames[l]}
          aria-current={l === lang ? 'page' : undefined}
          class="text-ink-500 aria-[current=page]:text-ink-900 inline-flex h-11 min-w-11 items-center justify-center px-2 uppercase transition-colors duration-150 hover:text-blue-600"
        >
          {l}
          <span class="sr-only">{localeNames[l]}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
