---
import Container from './Container.astro';

// One Home section: anchor id, vertical rhythm (96px / 64px) and optional surface background.
interface Props {
  id: string;
  labelledby?: string;
  surface?: boolean;
  class?: string;
}

const { id, labelledby, surface = false, class: className } = Astro.props;
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={['py-16 lg:py-24', surface ? 'bg-surface' : 'bg-white', className]}
>
  <Container>
    <slot />
  </Container>
</section>
