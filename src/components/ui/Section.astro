---
import Container from './Container.astro';

// One Home section: anchor id, vertical rhythm (96px / 64px) and optional surface background.
interface Props {
  id: string;
  labelledby?: string;
  surface?: boolean;
  /** Navy band with the dot pattern (MASTER §5.14); text inside must be white or blue-100. */
  dark?: boolean;
  class?: string;
}

const { id, labelledby, surface = false, dark = false, class: className } = Astro.props;
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={[
    'py-16 lg:py-24',
    dark ? 'bg-brand-navy bg-dots text-white' : surface ? 'bg-surface' : 'bg-white',
    className,
  ]}
>
  <Container>
    <slot />
  </Container>
</section>
