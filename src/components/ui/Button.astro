---
import type { HTMLAttributes } from 'astro/types';

// MASTER §5.1; Home's header and hero share the highlight treatment (pages/home.md).
const variants = {
  primary: 'bg-blue-600 text-white hover:bg-blue-700',
  secondary: 'border-[1.5px] border-blue-600 bg-white text-blue-600 hover:bg-blue-50',
  highlight: 'bg-gold-400 text-brand-navy hover:bg-gold-300',
  light: 'bg-white text-brand-navy hover:bg-blue-50',
  outlineLight: 'border border-blue-200/80 text-white hover:bg-white/10 focus-visible:outline-white',
} as const;

type Props = HTMLAttributes<'a'> & {
  variant?: keyof typeof variants;
  size?: 'md' | 'sm';
};

const { variant = 'primary', size = 'md', class: className, ...attrs } = Astro.props;
---

<a
  class:list={[
    'inline-flex cursor-pointer items-center justify-center gap-2 rounded-md font-semibold whitespace-nowrap transition duration-150 active:scale-[0.98]',
    size === 'md' ? 'h-12 px-6 text-base' : 'h-11 px-5 text-sm',
    variants[variant],
    className,
  ]}
  {...attrs}
>
  <slot />
</a>
