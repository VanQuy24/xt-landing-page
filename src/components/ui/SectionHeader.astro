---
// MASTER §5.5: optional kicker (label) → h2 → lead. Pass a label only when it says something the heading doesn't.
interface Props {
  label?: string;
  heading: string;
  lead?: string;
  id?: string;
  class?: string;
}

const { label, heading, lead, id, class: className } = Astro.props;
---

<div class:list={['max-w-3xl', className]}>
  {label && <p class="text-label mb-4 text-blue-600">{label}</p>}
  <h2 id={id} class="font-display text-h2 text-ink-900">
    {heading}
  </h2>
  {lead && <p class="text-lead text-ink-500 mt-4">{lead}</p>}
</div>
