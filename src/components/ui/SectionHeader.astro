---
// MASTER §5.5: optional kicker (label) → h2 → lead. Pass a label only when it says something the heading doesn't.
interface Props {
  label?: string;
  heading: string;
  lead?: string;
  id?: string;
  /** Light text for the navy band. */
  onDark?: boolean;
  class?: string;
}

const { label, heading, lead, id, onDark = false, class: className } = Astro.props;
---

<div class:list={['max-w-3xl', className]}>
  {label && <p class:list={['text-label mb-4', onDark ? 'text-blue-200' : 'text-blue-600']}>{label}</p>}
  <h2 id={id} class:list={['font-display text-h2', onDark ? 'text-white' : 'text-ink-900']}>
    {heading}
  </h2>
  {lead && <p class:list={['text-lead mt-4', onDark ? 'text-white/80' : 'text-ink-500']}>{lead}</p>}
</div>
