---
// MASTER §5.5: kicker (label) → h2 → lead.
interface Props {
  label?: string;
  heading: string;
  lead?: string;
  id?: string;
  class?: string;
}

const { label, heading, lead, id, class: className } = Astro.props;
---

<div class:list={['max-w-3xl', className]}>
  {label && (
    <p class="text-label flex items-center gap-3 text-blue-600 uppercase">
      <span class="h-1 w-8 rounded-full bg-blue-600" aria-hidden="true" />
      {label}
    </p>
  )}
  <h2 id={id} class="font-display text-h2 text-ink-900 mt-4">
    {heading}
  </h2>
  {lead && <p class="text-lead text-ink-500 mt-4">{lead}</p>}
</div>
