---
import { Font } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import Footer from '../components/sections/Footer.astro';
import Header from '../components/sections/Header.astro';
import { defaultLocale, getDictionary, locales, stripLocale, type Locale } from '../i18n';
import '../styles/global.css';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Keep the page out of search results (404). */
  noindex?: boolean;
  homeHeader?: boolean;
}

const { lang, title, description, noindex = false, homeHeader = false } = Astro.props;
const t = getDictionary(lang);

const path = stripLocale(Astro.url.pathname, lang);
const canonical = getAbsoluteLocaleUrl(lang, path);
// Social card per locale, generated from the brand assets (public/og-<lang>.png, 1200x630).
const ogImage = new URL(`/og-${lang}.png`, Astro.site).href;
const ogLocale = { en: 'en_US', vi: 'vi_VN' }[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l, path)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale, path)} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="XionTechs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.a11y.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-inter" preload />
  </head>
  <body class="text-body text-ink-700 min-h-dvh bg-white font-sans antialiased">
    <a
      href="#main"
      class="sr-only z-70 rounded-md bg-blue-600 px-5 py-3 font-semibold text-white focus:not-sr-only focus:fixed focus:start-4 focus:top-4"
    >
      {t.a11y.skip}
    </a>
    <Header lang={lang} variant={homeHeader ? 'home' : 'default'} />
    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
