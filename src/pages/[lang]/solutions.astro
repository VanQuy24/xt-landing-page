---
import type { GetStaticPaths } from 'astro';
import SolutionsPage from '../../components/SolutionsPage.astro';
import { isLocale, prefixedLocalePaths } from '../../i18n';

export const getStaticPaths = prefixedLocalePaths satisfies GetStaticPaths;

const { lang } = Astro.params;
if (!isLocale(lang)) throw new Error(`Unknown locale: ${lang}`);
---

<SolutionsPage lang={lang} />
